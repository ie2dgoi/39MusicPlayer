{
    "name": "39musicplayer",
    "version": "0.8.0-alpha.1",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/A439-Official/39MusicPlayer.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/A439-Official/39MusicPlayer/issues"
    },
    "homepage": "https://github.com/A439-Official/39MusicPlayer#readme",
    "devDependencies": {
        "electron": "^40.7.0",
        "electron-builder": "^26.8.1"
    },
    "build": {
        "appId": "xyz.a439.39musicplayer",
        "productName": "39MusicPlayer",
        "directories": {
            "output": "dist"
        },
        "publish": [
            {
                "provider": "github",
                "owner": "A439-Official",
                "repo": "39MusicPlayer"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "requestedExecutionLevel": "asInvoker",
            "icon": "resources/icon.ico"
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Audio",
            "icon": "resources/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "39MusicPlayer",
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "installerHeaderIcon": "resources/icon.ico"
        },
        "files": [
            "index.js",
            "preload.js",
            "scripts/**/*",
            "screen/**/*",
            "package.json",
            "resources/**/*"
        ]
    },
    "dependencies": {
        "electron-updater": "^6.8.3",
        "marked": "^18.0.5"
    }
}
